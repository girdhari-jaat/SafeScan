name: Build OpenCV Android (Optimized)

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-22.04

    env:
      ANDROID_SDK_ROOT: /usr/local/lib/android/sdk
      ANDROID_NDK_ROOT: /usr/local/lib/android/sdk/ndk/26.3.11579264

    steps:
      - uses: actions/checkout@v4

      - name: Install Packages
        run: |
          sudo apt update
          sudo apt install -y \
            ninja-build \
            zip \
            unzip \
            wget \
            ant \
            cmake

      - name: Setup Java 17
        uses: actions/setup-java@v4
        id: java
        with:
          distribution: temurin
          java-version: 17

      - name: Export JAVA_HOME
        run: |
          echo "JAVA_HOME=${{ steps.java.outputs.path }}" >> $GITHUB_ENV
          echo "${{ steps.java.outputs.path }}/bin" >> $GITHUB_PATH

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: Install Android SDK + NDK
        run: |
          mkdir -p $ANDROID_SDK_ROOT/cmdline-tools
          cd /tmp

          wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip

          unzip -q commandlinetools-linux-11076708_latest.zip

          mv cmdline-tools \
             $ANDROID_SDK_ROOT/cmdline-tools/latest

          yes | \
          $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager \
          --licenses

          $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager \
            "platform-tools" \
            "platforms;android-34" \
            "build-tools;34.0.0" \
            "ndk;26.3.11579264"

      - name: Download OpenCV 4.10.0
        run: |
          wget -q https://github.com/opencv/opencv/archive/refs/tags/4.10.0.zip
          unzip -q 4.10.0.zip
          mv opencv-4.10.0 opencv
      - name: Configure OpenCV
        run: |
          cmake -S opencv -B build \
            -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_TOOLCHAIN_FILE=$ANDROID_NDK_ROOT/build/cmake/android.toolchain.cmake \
            -DANDROID_ABI=arm64-v8a \
            -DANDROID_PLATFORM=android-21 \
            -DANDROID_SDK=$ANDROID_SDK_ROOT \
            -DANDROID_NDK=$ANDROID_NDK_ROOT \
            -DANDROID_STL=c++_shared \
            -DANT_EXECUTABLE=/usr/bin/ant \
            -DJava_JAVA_EXECUTABLE=$JAVA_HOME/bin/java \
            -DJava_JAVAC_EXECUTABLE=$JAVA_HOME/bin/javac \
            -DJava_JAR_EXECUTABLE=$JAVA_HOME/bin/jar \
            -DBUILD_SHARED_LIBS=ON \
            -DBUILD_JAVA=ON \
            -DBUILD_opencv_java=ON \
            -DBUILD_FAT_JAVA_LIB=OFF \
            --DBUILD_LIST=core,imgproc,imgcodecs,photo,calib3d,java \
            -DBUILD_TESTS=OFF \
            -DBUILD_PERF_TESTS=OFF \
            -DBUILD_EXAMPLES=OFF \
            -DBUILD_ANDROID_EXAMPLES=OFF \
            -DBUILD_ANDROID_PROJECTS=OFF \
            -DBUILD_JAVA_EXAMPLES=OFF \
            -DBUILD_DOCS=OFF \
            -DBUILD_PACKAGE=OFF \
            -DBUILD_opencv_apps=OFF \
            -DBUILD_ANDROID_SERVICE=OFF \
            -DWITH_IPP=OFF \
            -DWITH_TBB=OFF \
            -DWITH_ADE=OFF \
            -DWITH_EIGEN=OFF \
            -DWITH_OPENCL=OFF \
            -DWITH_OPENMP=OFF \
            -DWITH_OPENVX=OFF \
            -DWITH_VULKAN=OFF \
            -DWITH_HALIDE=OFF \
            -DWITH_QUIRC=OFF \
            -DWITH_PROTOBUF=OFF \
            -DWITH_1394=OFF \
            -DWITH_FFMPEG=OFF \
            -DWITH_GSTREAMER=OFF \
            -DWITH_V4L=OFF \
            -DWITH_JPEG=ON \
            -DWITH_PNG=ON \
            -DWITH_TIFF=OFF \
            -DWITH_WEBP=OFF \
            -DWITH_OPENEXR=OFF \
            -DWITH_JASPER=OFF \
            -DWITH_OPENJPEG=OFF \
            -DBUILD_ZLIB=ON \
            -DCMAKE_C_FLAGS="-Os -DNDEBUG -ffunction-sections -fdata-sections" \
            -DCMAKE_CXX_FLAGS="-Os -DNDEBUG -ffunction-sections -fdata-sections" \
            -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--gc-sections"
      - name: Build OpenCV
        run: |
          cmake --build build --parallel $(nproc)

      - name: Install SDK
        run: |
          cmake --install build --prefix install

      - name: Prepare Release Files
        run: |
          mkdir -p dist/arm64-v8a

          SO_FILE=$(find install -name "libopencv_java4.so" | head -n 1)
          JAR_FILE=$(find install -name "*.jar" | head -n 1)

          if [ -z "$SO_FILE" ]; then
            echo "libopencv_java4.so not found!"
            exit 1
          fi

          cp "$SO_FILE" dist/arm64-v8a/

          if [ -n "$JAR_FILE" ]; then
            cp "$JAR_FILE" dist/
          fi

      - name: Strip Debug Symbols
        run: |
          STRIP="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip"

          if [ -f "$STRIP" ]; then
            "$STRIP" --strip-debug dist/arm64-v8a/libopencv_java4.so
          fi

          ls -lh dist/arm64-v8a/

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: opencv-4.10.0-android-arm64
          path: dist
          if-no-files-found: error
